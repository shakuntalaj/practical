package com.hashedin.SocioApp.models;

import jakarta.persistence.*;

@Entity
@Table(name = "follows", uniqueConstraints = @UniqueConstraint(columnNames = {"follower_id", "following_id"}))
public class Follow {
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @ManyToOne
    @JoinColumn(name = "follower_id")
    private com.hashedin.SocioApp.login.models.User follower;

    @ManyToOne
    @JoinColumn(name = "following_id")
    private com.hashedin.SocioApp.login.models.User following;

    // Getters and Setters
}

