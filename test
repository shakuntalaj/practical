package com.hashedin.SocioApp.service;

import com.hashedin.SocioApp.model.Comment;
import com.hashedin.SocioApp.model.Post;
import com.hashedin.SocioApp.model.User;
import com.hashedin.SocioApp.repository.CommentRepository;
import com.hashedin.SocioApp.repository.PostRepository;
import com.hashedin.SocioApp.repository.UserRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class CommentService {

    @Autowired
    private CommentRepository commentRepository;

    @Autowired
    private UserRepository userRepository;

    @Autowired
    private PostRepository postRepository;

    public Comment commentOnPost(Long userId, Long postId, String text) {
        User user = userRepository.findById(userId).orElseThrow();
        Post post = postRepository.findById(postId).orElseThrow();

        Comment comment = new Comment();
        comment.setUser(user);
        comment.setPost(post);
        comment.setText(text);

        return commentRepository.save(comment);
    }
}



